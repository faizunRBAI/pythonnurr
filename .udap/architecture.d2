# udap:meta cloud=aws region=us-east-1 target=ec2

user: User { udap-type: generic.user }
cdn: Let's Encrypt TLS { udap-type: generic.cdn }
vpc: VPC {
  web: FastAPI Server { udap-type: aws.ec2 }
  nginx: Nginx Proxy { udap-type: generic.app }
}

user -> vpc.nginx: HTTPS (443) — www.faizun.hepttech.com
vpc.nginx -> vpc.web: Proxy (port 8000)
vpc.nginx -> cdn: certbot HTTP-01 renewal
